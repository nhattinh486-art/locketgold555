{
  "dns": {
    "servers": ["8.8.8.8", "1.1.1.1"]
  },
  "rules": [
    {
      "type": "urlrewrite",
      "match": "^https?://api\\.locketcamera\\.com/v\\d+/entitlements",
      "action": "rewrite-response",
      "target": "https://raw.githubusercontent.com/nhattinh486-art/locketgold-crack/main/gold_entitlements.json"
    },
    {
      "type": "urlrewrite",
      "match": "^https?://api\\.locketcamera\\.com/v\\d+/video/config",
      "action": "rewrite-response",
      "target": "https://raw.githubusercontent.com/nhattinh486-art/locketgold-crack/main/video_60s_config.json"
    },
    {
      "type": "urlrewrite",
      "match": "^https?://api\\.locketcamera\\.com/v\\d+/ai/features",
      "action": "rewrite-response",
      "target": "https://raw.githubusercontent.com/nhattinh486-art/locketgold-crack/main/ai_features_ptb.json"
    },
    {
      "type": "urlrewrite",
      "match": "^https?://api\\.locketcamera\\.com/v\\d+/subscription/verify",
      "action": "rewrite-response",
      "target": "https://raw.githubusercontent.com/nhattinh486-art/locketgold-crack/main/subscription_gold_ptb.json"
    },
    {
      "type": "urlrewrite",
      "match": "^https?://api\\.locketcamera\\.com/v\\d+/camera/limit",
      "action": "rewrite-response",
      "target": "https://raw.githubusercontent.com/[USERNAME]/locketgold-crack/main/camera_unlimited.json"
    }
  ]
}
